# ==========================================
# TNKÜ İME & STAJ ROBOTU - SUNUCU VE LOKAL ÇEVRE DEĞİŞKENLERİ
# ==========================================

# Telegram Bot Token (Telegram'da @BotFather üzerinden alınır)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram Chat ID (Telegram'da @userinfobot üzerinden kendi ID'nizi öğrenebilirsiniz)
TELEGRAM_CHAT_ID=123456789

# Otomatik Arka Plan Tarama Sıklığı (Saat cinsinden, varsayılan: 6)
SCAN_INTERVAL_HOURS=6

# Sunucu Çalışma Modu (polling veya webhook)
SERVER_MODE=polling

# SQLite Veritabanı Dosya Adı / Yolu (Göreceli verilirse proje kök dizinine sabitlenir)
DB_PATH=ime_leads.db

# HTTP İstek Zaman Aşımı (Saniye)
REQUEST_TIMEOUT=15
